{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "lib": [
            "ES2022",
            "DOM"
        ],
        "types": [
            "@cloudflare/workers-types",
            "vite/client",
            "node"
        ],
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "jsx": "preserve"
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.vue",
        "functions/**/*.ts",
        "vite.config.ts"
    ]
}
